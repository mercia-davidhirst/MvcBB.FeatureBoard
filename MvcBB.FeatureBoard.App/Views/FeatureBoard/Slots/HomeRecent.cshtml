@model IReadOnlyList<FeatureRequestDto>
<div class="card mb-4 fb-home-widget">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="bi bi-kanban"></i> Feature Board</h5>
    </div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <p class="text-muted small mb-2">No feature requests to show yet.</p>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var request in Model)
                {
                    var colour = FeatureStatusDisplay.Colour(request.Status);
                    <a asp-controller="FeatureBoard" asp-action="Details" asp-route-id="@request.Id" class="list-group-item list-group-item-action px-0">
                        <div class="fw-semibold text-truncate">@request.Title</div>
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <small class="text-muted text-truncate">by @request.AuthorUsername</small>
                            <span class="badge bg-@colour @(colour is "warning" or "info" ? "text-dark" : "") flex-shrink-0">@FeatureStatusDisplay.Name(request.Status)</span>
                        </div>
                    </a>
                }
            </div>
        }
        <a asp-controller="FeatureBoard" asp-action="Index" class="d-block mt-2 small">View the board</a>
    </div>
</div>
