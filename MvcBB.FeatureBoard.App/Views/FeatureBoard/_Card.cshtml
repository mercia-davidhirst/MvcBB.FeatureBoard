@model RequestCardModel
@{
    var r = Model.Request;
}
<div class="card fb-card" id="request-@r.Id">
    <div class="card-body p-2">
        <a asp-action="Details" asp-route-id="@r.Id" class="fb-card-title fw-semibold d-block">@r.Title</a>
        <div class="small text-muted fb-card-teaser">@Teaser.Of(r.Description)</div>
        <div class="d-flex justify-content-between align-items-center mt-2 small">
            <span class="text-muted text-truncate">by @r.AuthorUsername</span>
            <span class="d-flex align-items-center gap-2 flex-shrink-0">
                @if (Model.CanLike)
                {
                    <form asp-action="Like" asp-route-id="@r.Id" method="post" class="d-inline">
                        <input type="hidden" name="liked" value="@(Model.Liked ? "false" : "true")" />
                        <input type="hidden" name="fromBoard" value="@(Model.OnBoard ? "true" : "false")" />
                        <button type="submit" class="btn btn-sm py-0 px-1 @(Model.Liked ? "btn-danger" : "btn-outline-danger")"
                                title="@(Model.Liked ? "Unlike" : "Like")" aria-label="@(Model.Liked ? "Unlike" : "Like") @r.Title">
                            <i class="bi bi-heart@(Model.Liked ? "-fill" : "")"></i> @r.LikeCount
                        </button>
                    </form>
                }
                else
                {
                    <span class="text-muted" title="Likes"><i class="bi bi-heart"></i> @r.LikeCount</span>
                }
                <span class="text-muted" title="Comments"><i class="bi bi-chat"></i> @r.CommentCount</span>
            </span>
        </div>
    </div>
</div>
