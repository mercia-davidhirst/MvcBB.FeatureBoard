<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <!-- A drop-in mod DLL has no file watcher to fall back on for runtime
         Razor compilation - views must be precompiled in every configuration. -->
    <RazorCompileOnBuild>true</RazorCompileOnBuild>
    <RazorCompileOnPublish>true</RazorCompileOnPublish>
    <!-- Static files (wwwroot) are embedded in the DLL with a manifest, and
         MvcBB.App serves them at /_mods/featureboard/... (a Razor Class Library's
         usual /_content/ handling doesn't apply to a drop-in mod). -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MvcBB.FeatureBoard.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MvcBB\Solution\MvcBB.ModKit\MvcBB.ModKit.csproj" />
    <ProjectReference Include="..\..\MvcBB\Solution\MvcBB.Shared\MvcBB.Shared.csproj" />
  </ItemGroup>

</Project>
