@model ColumnPageModel
@{
    var name = FeatureStatusDisplay.Name(Model.Status);
    ViewData["Title"] = name + " - Feature Board";
    var results = Model.Results;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Feature Board</a></li>
        <li class="breadcrumb-item active" aria-current="page">@name</li>
    </ol>
</nav>

<h1 class="h2"><i class="bi @FeatureStatusDisplay.Icon(Model.Status)"></i> @name <small class="text-muted fs-5">(@results.TotalCount)</small></h1>
<p class="text-muted">@FeatureStatusDisplay.Hint(Model.Status)</p>


@if (results.Items.Count == 0)
{
    <p class="text-muted">Nothing here yet.</p>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-3">
        @foreach (var request in results.Items)
        {
            <div class="col"><partial name="~/Views/FeatureBoard/_Card.cshtml" model="new RequestCardModel(request, false, 0, false)" /></div>
        }
    </div>

    @if (results.TotalPages > 1)
    {
        <nav aria-label="@name pages">
            <ul class="pagination flex-wrap">
                @for (var p = 1; p <= results.TotalPages; p++)
                {
                    <li class="page-item @(p == results.Page ? "active" : "")">
                        <a class="page-link" asp-action="Column" asp-route-status="@Model.Status" asp-route-page="@p">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
